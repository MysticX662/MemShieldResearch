title: "MemShield: Mitigating Persistent Memory Poisoning in Stateful AI Agents"
type: report
authors:
  - family-names: Earla
    given-names: Nickhil
    orcid: ""
version: 1.0.0
date-released: 2026-05-22
publisher: "RevSoc Research Division"
license: MIT
repository-code: "https://github.com/MysticX662/MemShieldResearch"
